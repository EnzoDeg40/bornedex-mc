{
	chapter.603975FA9036B1EB.title: "Bornedex"
	quest.64D0A64936CA4E6E.quest_desc: ["Fabriquez un Repère de nivellement : un lingot de cuivre (le médaillon) entouré de quatre pépites de fer (le scellement)."]
	quest.64D0A64936CA4E6E.title: "Votre premier repère"
	quest.7B2E4C1D8A9F3E05.quest_desc: ["Fabriquez un Théodolite : une longue-vue montée sur deux bâtons."]
	quest.7B2E4C1D8A9F3E05.title: "Viser juste"
	quest.4F6A2B9C1D8E7530.quest_desc: ["Posez un Théodolite à moins de 10 blocs d'un repère vierge, en ligne de vue, et faites un clic droit dessus pour graver la cote."]
	quest.4F6A2B9C1D8E7530.title: "Premier nivellement"
	quest.2D7F9A3E6C1B8452.quest_desc: ["Maintenez le clic droit avec un pinceau sur un repère gravé pour effacer sa cote, afin de pouvoir le niveler à nouveau."]
	quest.2D7F9A3E6C1B8452.title: "Table rase"
	quest.5E3B8D1A7C4F2960.quest_desc: ["Renommez un Repère de nivellement avec une enclume. Son nom apparaît au-dessus de la plaque quand vous le regardez, et il le conserve une fois cassé (mais jamais sa cote)."]
	quest.5E3B8D1A7C4F2960.title: "Baptême"
}
